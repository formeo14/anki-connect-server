# Example environment configuration
# Copy to .env and adjust values

# Optional: path to your Anki collection (.anki2 file)
# Defaults to a temp path (collection.anki2) when not set
ANKICONNECT_COLLECTION_PATH=/path/to/your/collection.anki2

# Optional - Server settings
ANKICONNECT_PORT=8765
ANKICONNECT_BIND=127.0.0.1

# Optional - AnkiWeb sync (required for sync action)
# ANKICONNECT_ANKIWEB_USER=your@email.com
# ANKICONNECT_ANKIWEB_PASS=your_password

# Optional - Custom sync server (default: AnkiWeb)
# ANKICONNECT_ANKIWEB_URL=https://sync.ankiweb.net

# Optional - asbplayer WebSocket server integration
# Post-mine action when an addNote request is intercepted:
# 0 = None, 1 = Open Anki dialog, 2 = Update last card, 3 = Export card, 4 = Show update card dialog
# ANKICONNECT_ASB_POST_MINE_ACTION=2
# Only intercept addNote when the note's field matches this value (empty = intercept all)
# ANKICONNECT_ASB_INTERCEPT_FIELD=
# ANKICONNECT_ASB_INTERCEPT_VALUE=

# Loudness normalization for stored audio (requires ffmpeg): off | fixed | auto
# ANKICONNECT_AUDIO_NORMALIZATION=off
# Target in LUFS for "fixed" mode, and the fallback for "auto" until a target is measured
# ANKICONNECT_AUDIO_NORMALIZATION_TARGET_LUFS=-23.0
# ANKICONNECT_FFMPEG_PATH=ffmpeg
